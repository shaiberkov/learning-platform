# Copy to backend/.env (ignored by git) for local runs; spring-dotenv loads it on startup.
# On Render set the same names in the service's Environment tab. Never commit real values.

# --- Database (production profile; the dev profile uses localhost:3306/learning and only reads DB_PASSWORD)
DB_URL=jdbc:mysql://localhost:3306/learning?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=
DB_PASSWORD=

# --- Spring profile. application.properties defaults to production; locally run with -Dspring-boot.run.profiles=dev.
# Add json-logs for structured (ECS JSON) console logs, e.g. SPRING_PROFILES_ACTIVE=production,json-logs
# SPRING_PROFILES_ACTIVE=production

# Hibernate schema check in production (default validate). Emergency fallback: none.
# JPA_DDL_AUTO=validate

# --- JWT signing key: Base64 of at least 32 random bytes. Required in production (startup fails without it);
# other profiles fall back to a random key per run. Generate with: openssl rand -base64 32
JWT_SECRET=

# --- External services. Missing keys disable the feature with a Hebrew error instead of crashing.
GPT_TOKEN=
# Gmail app password of the sending account (utils/ApiEmailProcessor). Login codes go out by e-mail.
EMAIL_APP_PASSWORD=

# --- Error reporting (optional). Empty = Sentry disabled.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
