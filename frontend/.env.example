# Copy to .env.local (ignored by git) to override anything here for your machine.
# Vite only exposes variables that start with VITE_, and bakes them into the build:
# set them in the build environment (Render: the static site's Environment tab), not at runtime.

# API server. Default when unset: https://learning-project-server.onrender.com (production).
# `npm run dev` already uses http://localhost:8080 from .env.development.
VITE_API_URL=

# Optional error reporting. Empty = Sentry is never loaded.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
