<config xmlns="http://www.ehcache.org/v3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://www.ehcache.org/schema/ehcache-core.xsd">

    <cache alias="upcomingEvents">
        <expiry>
            <ttl unit="hours">24</ttl>
        </expiry>
        <heap>1000</heap>
    </cache>
    <cache alias="receivedMessages">
        <expiry>
            <ttl unit="hours">24</ttl>
        </expiry>
        <heap>1000</heap>
    </cache>
    <cache alias="teacherSchedule">
        <expiry>
            <ttl unit="hours">24</ttl>
        </expiry>
        <heap>500</heap>
    </cache>
    <cache alias="schoolDTO">
        <expiry>
            <ttl unit="hours">24</ttl>
        </expiry>
        <heap>100</heap>
    </cache>
    <cache alias="classRoomSchedule">
        <expiry>
            <ttl unit="hours">24</ttl>
        </expiry>
        <heap>100</heap>
    </cache>
    <cache alias="studentSchedule">
        <expiry>
            <ttl unit="hours">24</ttl>
        </expiry>
        <heap>1000</heap>
    </cache>
    <cache alias="allSchools">
        <expiry>
            <ttl unit="hours">24</ttl>
        </expiry>
        <heap>100</heap>
    </cache>
    <cache alias="studentTestsStatus">
        <expiry>
            <ttl unit="hours">24</ttl>
        </expiry>
        <heap>1000</heap>
    </cache>
    <!-- AI prompt cache: SHA-256 of (provider, model, messages, settings) -> model answer text.
         Filled only for one-shot calls (question generation, grading, insights). -->
    <cache alias="aiPromptCache">
        <expiry>
            <ttl unit="hours">24</ttl>
        </expiry>
        <heap>500</heap>
    </cache>



    <!-- Per-school feature flags (FeatureFlagService.flagsForSchool), key = schoolCode -->
    <cache alias="schoolFeatureFlags">
        <expiry>
            <ttl unit="hours">24</ttl>
        </expiry>
        <heap>200</heap>
    </cache>
</config>
